rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──

    function isSignedIn() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || (
          !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') in ['suspended', 'deleted', 'disabled']) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deletedAt', null) == null &&
          request.auth.token.get('auth_time', 0) > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('claimsValidAfter', -1)
        )
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function memberData() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    // Personal edits cannot grant roles, relink organizations, or undo suspension.
    function profileFields() {
      return ['displayName', 'name', 'community', 'location', 'bio', 'interests',
        'photoURL', 'nation', 'territory', 'languages', 'headline', 'skillsText',
        'openToWork', 'targetRoles', 'salaryRange', 'workPreference', 'skills',
        'education', 'resumeUrl', 'resumeURL', 'resumeFileName', 'resumeUploadedAt',
        'hideFromDirectory', 'onboardingComplete', 'band', 'pronouns', 'title',
        'experienceLevel', 'industry', 'preferredLocation', 'remoteOk', 'jobTypes',
        'willingToRelocate', 'updatedAt'];
    }
    function safeProfileCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly(profileFields().concat(['uid', 'email', 'joinedAt', 'createdAt', 'role']))
        && data.get('uid', request.auth.uid) == request.auth.uid
        && data.get('role', 'community') in ['community', 'member'];
    }
    function safeProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields());
    }
    // Platform privileges come from signed claims, never an editable profile role.
    function currentManagedRoleMatches(role) {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('claimsValidAfter', null) == null ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == role;
    }
    function isAdmin() {
      return isSignedIn() && currentManagedRoleMatches('admin') && (request.auth.token.get('admin', false) == true || request.auth.token.get('role', '') == 'admin');
    }
    function isAdminOrMod() {
      return isAdmin() || (isSignedIn() && currentManagedRoleMatches('moderator') && request.auth.token.get('role', '') == 'moderator');
    }

    function isOrgManager(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        memberData().orgId is string && memberData().orgId.size() > 0 && memberData().orgId == orgId &&
        memberData().orgRole in ["owner", "admin"];
    }

    // ── Public content collections ──

    // Job drafts, edits and publishing use authenticated server routes, including
    // admin actions. Those routes enforce ownership and featured entitlements.
    match /jobs/{jobId} {
      allow read, write: if false; // Sanitized public and owner APIs only.
    }

    function isOrgMember(orgId) {
      return isSignedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && orgId is string && orgId.size() > 0 && memberData().get('orgId', '') == orgId;
    }

    // Public organization data is served through a sanitized, visibility-checked API.
    // All listing creation and public edits use server routes to preserve review state.
    function safePrivateOrganizationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailTemplates', 'updatedAt']);
    }

    match /employers/{employerId} {
      allow read: if isOwner(employerId) || isOrgMember(employerId) || isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false; // Destructive actions require the verified owner API.
    }

    // Private account records: own reads/edits only; administration uses server APIs.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && safeProfileCreate();
      allow update: if isOwner(userId) && safeProfileUpdate();
      allow delete: if false; // Destructive actions require the verified owner API.
    }

    // Scholarships: public API reads; organization edits use authenticated server routes.
    match /scholarships/{scholarshipId} {
      allow read: if isAdmin() || isOwner(resource.data.get('orgId', '')) || isOrgMember(resource.data.get('orgId', ''));
      allow write: if isAdmin();
    }

    // Conferences: public read, admin write, org owner/admin can create/update/delete their org's
    match /conferences/{conferenceId} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isOrgManager(request.resource.data.orgId);
      allow update: if isOrgManager(resource.data.orgId) && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOrgManager(resource.data.orgId);
    }

    // Events: public API reads; organization edits use authenticated server routes.
    match /events/{eventId} {
      allow read: if isAdmin() || isOwner(resource.data.get('orgId', '')) || isOrgMember(resource.data.get('orgId', ''));
      allow write: if isAdmin();
    }

    // RSS feeds collection: public read, admin write
    match /rssFeeds/{feedId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stories: public read, admin write
    match /stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Saved items: users can read/write their own saved items only
    match /saved_items/{itemId} {
      allow read, write: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Full applications contain private employer notes and delivery metadata.
    // Applicant receipts and employer views are authorized and projected by APIs.
    match /applications/{applicationId} {
      allow read, write: if false;
    }

    // Organization posts use server routes. The only client-create exception is
    // the existing community story/spotlight payload, without paid/org fields.
    match /posts/{postId} {
      allow read: if false; // Public API excludes unpublished records.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['type', 'title', 'description',
          'authorUid', 'authorName', 'authorPhoto', 'featuredImage', 'status', 'createdAt', 'order'])
        && request.resource.data.type in ['story', 'spotlight']
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'active';
      allow update, delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if isOwner(orgId) || isOrgMember(orgId) || isAdmin();
      allow create: if false;
      allow update: if (isOrgManager(orgId) || isAdmin()) && safePrivateOrganizationUpdate();
      allow delete: if false; // Destructive actions require the verified owner API.
    }

    // Organization team invites: org owners/admins can manage their own invites.
    match /organizations/{orgId}/teamInvites/{inviteId} {
      allow read, create, update, delete: if isOrgManager(orgId) || isAdmin();
    }

    // Shop vendors: public read, admin/moderator write
    match /shop_vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdminOrMod();
    }

    // Shop listings: public read, admin/moderator write
    match /shop_listings/{listingId} {
      allow read: if true;
      allow write: if isAdminOrMod();
    }

    // Training programs: public read, admin/moderator write
    match /training_programs/{programId} {
      allow read: if true;
      allow write: if isAdminOrMod();
    }

    // Retired endorsements: historical admin access only.
    match /endorsements/{recordId} {
      // Retired social graph: keep historical records; no client mutations.
      allow read: if isAdmin();
      allow write: if false;
    }

    // Livestreams: public read, admin write
    match /livestreams/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Partner showcase: public read, admin write
    match /partner_showcase/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Retired mentor profiles: historical admin access only.
    match /mentor_profiles/{recordId} {
      // Retired social graph: keep historical records; no client mutations.
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Authenticated collections ──

    // Private member records. Browsing is retired; own access stays unchanged.
    match /members/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && safeProfileCreate();
      allow update: if isOwner(userId) && safeProfileUpdate();
      allow delete: if false; // Destructive actions require the verified owner API.
    }

    // Saved items: users can read/write their own saves
    match /saved_items/{itemId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Applications are defined above near public content collections.
    // Keep this duplicate match intentionally narrow to avoid broad org-owner reads.
    match /applications/{appId} {
      allow read, update: if false;
    }

    // Notifications: users can read/update/create their own
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Existing conversations: participants can read/update; creation is retired.
    // Allow get for non-existent docs (existence check before create).
    // Allow list when querying by unreadBy (used for unread count badge).
    match /conversations/{convId} {
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/conversations/$(convId)) ||
        request.auth.uid in resource.data.participants
      );
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.participants
      );
      allow create: if false; // Existing conversations only; no forged peer-lookup grants.
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
    }

    // Messages: only conversation participants can read,
    // authenticated users can create messages in their conversations
    match /messages/{msgId} {
      allow read: if isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
    }

    // Member settings: users can read/write their own settings
    match /member_settings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
    }

    // Notification preferences: users can read/write their own preferences
    match /notification_preferences/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
    }

    // Event RSVPs: authenticated users can read (for count queries),
    // users can create/update/delete their own RSVPs
    match /event_rsvps/{rsvpId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Content reports: authenticated users can create (own reporterId),
    // users can read their own reports, admin can read/update all
    match /content_reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Mail queue: authenticated users can create (queue emails),
    // only admin can read (view queue and stats)
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if false;
    }

    // Retired follow graph: historical admin access only.
    match /connections/{recordId} {
      // Retired social graph: keep historical records; no client mutations.
      allow read: if isAdmin();
      allow write: if false;
    }

    // Billing receipts are written only by authenticated server payment/admin paths.
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (
        resource.data.orgId == request.auth.uid ||
        isAdminOrMod()
      );
      allow write: if false;
    }

    // Training enrollments: users can read/create/update their own, admin/moderator can read all
    match /training_enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdminOrMod()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Feed sources: admin only
    match /feed_sources/{docId} {
      allow read, write: if isAdmin();
    }

    // Retired private requests: Admin SDK archival access only.
    match /mentorship_requests/{recordId} {
      // Retired social graph: keep historical records; no client mutations.
      allow read: if false;
      allow write: if false;
    }

    // Unpublished scholarship and event content is only accessible through owner APIs.
    match /organizationOpportunityDrafts/{id} {
      allow read, write: if false;
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
